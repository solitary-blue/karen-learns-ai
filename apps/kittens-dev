#!/usr/bin/env bash

# Require bash >= 5.0
min_major=5
min_minor=0

if (( BASH_VERSINFO[0] < min_major || (BASH_VERSINFO[0] == min_major && BASH_VERSINFO[1] < min_minor) )); then
  echo "ERROR: Bash ${min_major}.${min_minor}+ required. Found ${BASH_VERSION}." >&2
  exit 1
fi

set -euo pipefail

# Launch the Kittens lesson viewer in development mode and open it in your browser.

KITTENS_DIR="$(cd "$(dirname "$0")/../.apps/kittens" && pwd)"
PORT="${PORT:-3000}"
KITTENS_URL="http://localhost:${PORT}"

cd "$KITTENS_DIR" || {
  echo "Could not find kittens app at $KITTENS_DIR" >&2
  exit 1
}

if [ ! -d node_modules ]; then
  echo "Installing dependencies (first run)..."
  npm install --legacy-peer-deps
fi

(sleep 2 && open "$KITTENS_URL") &

echo "Starting Kittens in development mode on port ${PORT}..."
exec npm run dev -- --port "$PORT"
