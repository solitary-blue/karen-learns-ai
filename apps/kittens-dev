#!/usr/bin/env bash

# Require bash >= 5.0
min_major=5
min_minor=0

if (( BASH_VERSINFO[0] < min_major || (BASH_VERSINFO[0] == min_major && BASH_VERSINFO[1] < min_minor) )); then
  echo "ERROR: Bash ${min_major}.${min_minor}+ required. Found ${BASH_VERSION}." >&2
  exit 1
fi

set -euo pipefail

# Launch the Kittens lesson viewer in development mode and open it in your browser.

KITTENS_DIR="$(cd "$(dirname "$0")/../.apps/kittens" && pwd)"
PORT_WAS_SET=0
if [[ -n "${PORT+x}" ]]; then
  PORT_WAS_SET=1
fi

REQUESTED_PORT="${PORT:-3001}"
PORT="$REQUESTED_PORT"
KITTENS_URL="http://localhost:${PORT}"

port_in_use() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

if port_in_use "$PORT"; then
  if (( PORT_WAS_SET )); then
    echo "Port ${PORT} is already in use. Try a different non-3000 port, for example: PORT=3002 apps/kittens-dev" >&2
    exit 1
  fi

  candidate_port=3001
  while port_in_use "$candidate_port" || [[ "$candidate_port" == "3000" ]]; do
    candidate_port=$((candidate_port + 1))
  done

  PORT="$candidate_port"
  echo "Port ${REQUESTED_PORT} is busy; using port ${PORT} for Kittens dev instead."
fi

KITTENS_URL="http://localhost:${PORT}"

cd "$KITTENS_DIR" || {
  echo "Could not find kittens app at $KITTENS_DIR" >&2
  exit 1
}

if [ ! -d node_modules ]; then
  echo "Installing dependencies (first run)..."
  npm install --legacy-peer-deps
fi

(sleep 2 && open "$KITTENS_URL") &

echo "Starting Kittens in development mode on port ${PORT}..."
exec npm run dev -- --port "$PORT"
